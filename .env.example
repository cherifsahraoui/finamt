# finamt — copy to .env and adjust

# LLM — models are downloaded automatically from HuggingFace on first use (~4 GB)
# Supported: mistral:7b | qwen2.5:7b-instruct-q4_K_M
FINAMT_AGENT_MODEL=mistral:7b
FINAMT_AGENT_NUM_CTX=4096
FINAMT_AGENT_MAX_RETRIES=3
FINAMT_AGENT_TIMEOUT=60

# OCR
FINAMT_OCR_LANGUAGE=german
FINAMT_OCR_TIMEOUT=60
FINAMT_OCR_PREPROCESS=true
FINAMT_TESSERACT_CMD=tesseract
FINAMT_PDF_DPI=300

# ELSTER (ERiC) — never commit real values. Copy to .env (git-ignored).
# Directory containing libericapi.(so|dylib|dll) and plugins/, used by the web UI / UStVA path
FINAMT_ERIC_HOME=/path/to/ERiC-x.y.z/<platform>/lib
# Same directory, read by finamt.tax.eur_elster (EÜR). Only this variable is used there.
ERIC_LIBRARY_PATH=/path/to/ERiC-x.y.z/<platform>/lib
FINAMT_ELSTER_CERT_PATH=~/.finamt/default/elster_cert.pfx
FINAMT_ELSTER_CERT_PASSWORD=
# 13-stellige ELSTER-Steuernummer (Bundesschema), digits only
FINAMT_ELSTER_STEUERNUMMER=
FINAMT_ELSTER_FINANZAMT_NR=
FINAMT_ELSTER_BUNDESLAND_KZ=
# Your own Hersteller-ID from the ELSTER developer portal
FINAMT_ELSTER_HERSTELLER_ID=
# Live (legally binding) ELSTER submission is disabled unless this is exactly 1.
FINAMT_ALLOW_LIVE_SUBMISSION=0
